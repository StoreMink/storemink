# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python bytecode (written whenever a scripts/*.py file runs)
__pycache__/
*.py[cod]

.mcp.json

# staging data dump (test-user contact data — local re-seed source only)
db-data.sql

# The capture job installs its own dependency (Track 3.6).
/jobs/*/node_modules
# So does the image-matting service (services/image-matting).
/services/*/node_modules

# Third-party reference screenshots for the Theme Studio benchmark (never commit).
/.theme-studio-references/

# Rendered email previews from `npm run email:gallery` (regenerate any time).
/.email-gallery/
.marketing-raw/
