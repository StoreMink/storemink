# Keep these files' line endings exactly as stored in Git, whatever a machine's
# core.autocrlf says (Git for Windows defaults it to true).
#
# Migrations are checksummed byte for byte (scripts/db-migrations-core.mjs), and
# the ledger holds the LF checksums, so a CRLF checkout reports every applied
# migration as drifted and `db:migrate` refuses to run.
drizzle/migrations/** text eol=lf

# Bash cannot run a script with CRLF line endings ("$'\r': command not found"),
# and Git Bash is npm's script-shell on Windows.
*.sh text eol=lf
